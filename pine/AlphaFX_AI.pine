        )

        table.cell(
             dashboard,
             1,
             16,
             lastLowType,
             text_color =
                 lastLowType == "HL"
                     ? bullishColor
                     : lastLowType == "LL"
                     ? bearishColor
                     : neutralColor
        )

        //------------------------------------------------------------
