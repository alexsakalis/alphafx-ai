        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             17,
             "Alignment",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             17,
             str.tostring(
                 alignmentScore,
                 "#"
             ) + "%",
             text_color = marketBiasColor
        )

        //------------------------------------------------------------
        // CONFIDENCE
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             18,
             "Confidence",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             18,
             enableConfidence
                 ? confidenceText + " " + confidenceDirectionText
                 : "OFF",
             text_color = confidenceColor,
             bgcolor = color.new(confidenceColor, 88)
        )

        //------------------------------------------------------------
        // RISK
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             19,
             "Risk",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             19,
             riskText,
             text_color = riskColor,
             bgcolor = color.new(riskColor, 88)
        )

        //------------------------------------------------------------
        // RISK SIZE
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             20,
             "Risk Size",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             20,
             riskQtyText,
             text_color = riskColor
        )

        //------------------------------------------------------------
        // BIAS
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             21,
             "Bias",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             21,
             marketBias,
             text_color = marketBiasColor,
             bgcolor = color.new(
                 marketBiasColor,
                 85
             )
        )

    else

        table.clear(
             dashboard,
             0,
             0,
             1,
             21
        )


//====================================================================
// ALERTS
//====================================================================
//
// One-bar pulses only. Structure, OB, FVG, Liquidity, and Session
// events inherit the confirmed-close non-repainting policy.
//====================================================================

alertcondition(
     bullishBosEvent,
     title = "Bullish BOS",
     message = "AlphaFX AI: Bullish Break of Structure"
)

alertcondition(
     bearishBosEvent,
     title = "Bearish BOS",
     message = "AlphaFX AI: Bearish Break of Structure"
)

alertcondition(
     bullishChochEvent,
     title = "Bullish CHoCH",
     message = "AlphaFX AI: Bullish Change of Character"
)

alertcondition(
     bearishChochEvent,
     title = "Bearish CHoCH",
     message = "AlphaFX AI: Bearish Change of Character"
)

alertcondition(
     bullishObCreatedEvent,
     title = "Bullish Order Block",
     message = "AlphaFX AI: Bullish Order Block created"
)

alertcondition(
     bearishObCreatedEvent,
     title = "Bearish Order Block",
     message = "AlphaFX AI: Bearish Order Block created"
)

alertcondition(
     bullishObMitigatedEvent,
     title = "Bullish OB Mitigated",
     message = "AlphaFX AI: Bullish Order Block mitigated"
)

alertcondition(
     bearishObMitigatedEvent,
     title = "Bearish OB Mitigated",
     message = "AlphaFX AI: Bearish Order Block mitigated"
)

alertcondition(
     bullishObInvalidatedEvent,
     title = "Bullish OB Invalidated",
     message = "AlphaFX AI: Bullish Order Block invalidated"
)

alertcondition(
     bearishObInvalidatedEvent,
     title = "Bearish OB Invalidated",
     message = "AlphaFX AI: Bearish Order Block invalidated"
)

alertcondition(
     bullishFvgCreatedEvent,
     title = "Bullish FVG",
     message = "AlphaFX AI: Bullish Fair Value Gap created"
)

alertcondition(
     bearishFvgCreatedEvent,
     title = "Bearish FVG",
     message = "AlphaFX AI: Bearish Fair Value Gap created"
