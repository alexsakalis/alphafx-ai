             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             15,
             lastHighType,
             text_color =
                 lastHighType == "HH"
                     ? bullishColor
                     : lastHighType == "LH"
                     ? bearishColor
                     : neutralColor
        )

        //------------------------------------------------------------
