//@version=6
indicator(
    "AlphaFX AI [v1.2.0]",
    shorttitle = "AlphaFX AI",
    overlay = true,
    max_labels_count = 500,
    max_lines_count = 400,
    max_boxes_count = 400
)

//====================================================================
// ALPHAFX AI
// Version: 1.2.0
// Status: Professional Release
//
// Product:
// Commercial-quality Smart Money Concepts indicator for TradingView.
// Original implementations. Confirmed-structure architecture.
// Profile presets: Scalp / Intraday / Swing / Custom.
// Quality filters: Premium/Discount, Killzone arming, Breaker blocks.
//
// Engine pipeline:
// Inputs
// → Trend Engine
// → Swing Engine
// → Structure Engine
// → BOS Engine
// → CHoCH Engine
// → Order Block Engine
// → Breaker Block Engine
// → Fair Value Gap Engine
// → Liquidity Engine
// → Session Engine
// → Premium / Discount Engine
// → Multi-Timeframe Engine
// → Confidence Engine
// → Risk Engine
// → Dashboard
// → Alerts
//
// Non-repainting policy:
// - Confirmed pivots only
// - Structure breaks require closed-bar confirmation
// - HTF data uses completed higher-timeframe bars only
// - No intentional future-looking logic
//
// Important:
// - Confidence is confluence quality, not win probability
// - Risk levels are educational guidance, not trade execution
// - This script does not place orders
//====================================================================


//====================================================================
// INPUT GROUPS
//====================================================================

string GROUP_PRESET     = "Profile Preset"
string GROUP_TREND      = "Trend Engine"
string GROUP_STRUCTURE  = "Market Structure"
string GROUP_BOS        = "BOS / CHoCH"
string GROUP_OB         = "Order Blocks"
string GROUP_BREAKER    = "Breaker Blocks"
string GROUP_FVG        = "Fair Value Gaps"
string GROUP_LIQUIDITY  = "Liquidity"
string GROUP_SESSIONS   = "Sessions"
string GROUP_PD         = "Premium / Discount"
string GROUP_MTF        = "Multi-Timeframe"
string GROUP_CONFIDENCE = "Confidence"
string GROUP_RISK       = "Risk"
string GROUP_VISUALS    = "Visuals"
string GROUP_DASHBOARD  = "Dashboard"


//====================================================================
// PROFILE PRESET
//====================================================================
//
// Non-Custom presets apply tuned defaults for structure sensitivity,
// confluence filters, HTF confirmation, and risk geometry.
// Visual toggles remain user-controlled in all presets.
//====================================================================

string profilePreset = input.string(
     "Intraday",
     "Profile",
     options = ["Custom", "Scalp", "Intraday", "Swing"],
     tooltip = "Custom uses the manual inputs below. Other profiles override key structure, MTF, confidence, and risk settings.",
     group = GROUP_PRESET
)


//====================================================================
// TREND INPUTS
//====================================================================

bool showEMAs = input.bool(
     true,
     "Show EMAs",
     group = GROUP_TREND
)

int fastEmaLength = input.int(
     20,
     "Fast EMA",
     minval = 1,
     group = GROUP_TREND
)

int mediumEmaLength = input.int(
     50,
     "Medium EMA",
     minval = 1,
     group = GROUP_TREND
)

int slowEmaLength = input.int(
     200,
     "Slow EMA",
     minval = 1,
     group = GROUP_TREND
)

bool usePriceFilter = input.bool(
     true,
     "Require Price Above/Below Slow EMA",
     tooltip = "Bullish trend requires price above the slow EMA. Bearish trend requires price below it.",
     group = GROUP_TREND
)


//====================================================================
// STRUCTURE INPUTS
//====================================================================

int pivotLengthInput = input.int(
     5,
     "Pivot Length",
     minval = 1,
     maxval = 50,
     tooltip = "Used when Profile = Custom. Higher values detect larger structural swings and reduce noise.",
     group = GROUP_STRUCTURE
)

bool showStructureLabels = input.bool(
     true,
     "Show HH / HL / LH / LL",
     group = GROUP_STRUCTURE
)


//====================================================================
// BOS / CHOCH INPUTS
//====================================================================

bool showStructureLines = input.bool(
     true,
     "Show Structure Lines",
     tooltip = "Dashed horizontal levels at the active confirmed swing high and low.",
     group = GROUP_BOS
)

bool showBosChochLabels = input.bool(
     true,
     "Show BOS / CHoCH Labels",
     group = GROUP_BOS
)


//====================================================================
// ORDER BLOCK INPUTS
//====================================================================

bool showOrderBlocks = input.bool(
     true,
     "Show Order Blocks",
     group = GROUP_OB
)

bool createObFromChoch = input.bool(
     true,
     "Create OB from CHoCH",
     tooltip = "When disabled, order blocks are created only from BOS events.",
     group = GROUP_OB
)

int obLookbackInput = input.int(
     20,
     "OB Candle Lookback",
     minval = 1,
     maxval = 100,
     tooltip = "Used when Profile = Custom. How far back to search for the last opposing candle before a structure break.",
     group = GROUP_OB
)

int maxOrderBlocksInput = input.int(
     8,
     "Max Active Order Blocks",
     minval = 1,
     maxval = 50,
     tooltip = "Used when Profile = Custom.",
     group = GROUP_OB
)

bool keepMitigatedOrderBlocks = input.bool(
     true,
     "Keep Mitigated Order Blocks",
     tooltip = "When enabled, mitigated OBs stay visible with reduced opacity until invalidated.",
     group = GROUP_OB
)


//====================================================================
// BREAKER BLOCK INPUTS
//====================================================================

bool showBreakerBlocks = input.bool(
     true,
     "Show Breaker Blocks",
     tooltip = "Failed / invalidated order blocks flipped into opposite breaker zones.",
     group = GROUP_BREAKER
)

int maxBreakerBlocks = input.int(
     6,
     "Max Active Breakers",
     minval = 1,
     maxval = 50,
     group = GROUP_BREAKER
)

bool keepMitigatedBreakers = input.bool(
     true,
     "Keep Mitigated Breakers",
     group = GROUP_BREAKER
)


//====================================================================
// FAIR VALUE GAP INPUTS
//====================================================================

bool showFairValueGaps = input.bool(
     true,
     "Show Fair Value Gaps",
     group = GROUP_FVG
)

float fvgMinAtrMultInput = input.float(
     0.0,
     "Min FVG Size (ATR Mult)",
     minval = 0.0,
     step = 0.05,
     tooltip = "Used when Profile = Custom. Ignore gaps smaller than ATR(14) * this value. 0 = keep all gaps.",
     group = GROUP_FVG
)

int maxFairValueGapsInput = input.int(
     8,
     "Max Active FVGs",
     minval = 1,
     maxval = 50,
     tooltip = "Used when Profile = Custom.",
     group = GROUP_FVG
)

bool keepMitigatedFvg = input.bool(
     true,
     "Keep Mitigated FVGs",
     tooltip = "When enabled, touched FVGs stay visible with reduced opacity until fully filled.",
     group = GROUP_FVG
)

bool fvgRequireStructureAlignInput = input.bool(
     false,
     "Require Structure Alignment",
     tooltip = "Used when Profile = Custom. When enabled, bullish FVGs require bullish/unset structure direction and bearish FVGs require bearish/unset structure direction.",
     group = GROUP_FVG
)


//====================================================================
// LIQUIDITY INPUTS
//====================================================================

bool showLiquidity = input.bool(
     true,
     "Show Liquidity Levels",
     tooltip = "Draw equal high (EQH) and equal low (EQL) liquidity pools.",
     group = GROUP_LIQUIDITY
)

float liqToleranceAtrMultInput = input.float(
     0.15,
     "Equal Level Tolerance (ATR Mult)",
     minval = 0.01,
     step = 0.01,
     tooltip = "Used when Profile = Custom. Two confirmed swings form a liquidity pool when their distance is within ATR(14) * this value.",
     group = GROUP_LIQUIDITY
)

int maxLiquidityLevelsInput = input.int(
     8,
     "Max Active Liquidity Levels",
     minval = 1,
     maxval = 50,
     tooltip = "Used when Profile = Custom.",
     group = GROUP_LIQUIDITY
)

int liqSwingHistoryInput = input.int(
     12,
     "Swing History Depth",
     minval = 2,
     maxval = 50,
     tooltip = "Used when Profile = Custom. How many confirmed swings to compare when searching for equal highs / lows.",
     group = GROUP_LIQUIDITY
)

bool showLiquidityLabels = input.bool(
     true,
     "Show EQH / EQL Labels",
     group = GROUP_LIQUIDITY
)

bool showSweepLabels = input.bool(
     true,
     "Show Sweep Labels",
     group = GROUP_LIQUIDITY
)


//====================================================================
// SESSION INPUTS
//====================================================================

bool showSessions = input.bool(
     true,
     "Show Session Boxes",
     group = GROUP_SESSIONS
)

string sessionTimezone = input.string(
     "America/New_York",
     "Session Timezone",
     options = ["America/New_York", "Europe/London", "UTC", "Asia/Tokyo", "Exchange"],
     group = GROUP_SESSIONS
)

string asianSessionInput = input.session(
     "1800-0300",
     "Asian Session",
     group = GROUP_SESSIONS
)

string londonSessionInput = input.session(
     "0300-1200",
     "London Session",
     group = GROUP_SESSIONS
)

string newYorkSessionInput = input.session(
     "0800-1700",
     "New York Session",
     group = GROUP_SESSIONS
)

bool showAsianSession = input.bool(
     true,
     "Track Asian",
     group = GROUP_SESSIONS
)

bool showLondonSession = input.bool(
     true,
     "Track London",
     group = GROUP_SESSIONS
)

bool showNewYorkSession = input.bool(
     true,
     "Track New York",
     group = GROUP_SESSIONS
)

bool showSessionLevels = input.bool(
     true,
     "Show Completed Session Levels",
     tooltip = "Extend high / low lines from the most recently completed session ranges.",
     group = GROUP_SESSIONS
)

int maxSessionBoxes = input.int(
     9,
     "Max Session Boxes",
     minval = 3,
     maxval = 60,
     group = GROUP_SESSIONS
)

bool enableKillzoneArming = input.bool(
     true,
     "Enable Killzone Arming",
     tooltip = "Arms confidence/risk quality filters during London Open and New York Open windows only.",
     group = GROUP_SESSIONS
)

string londonKillzoneInput = input.session(
     "0300-0500",
     "London Killzone",
     tooltip = "Interpreted in the Session Timezone.",
     group = GROUP_SESSIONS
)

string newYorkKillzoneInput = input.session(
     "0930-1130",
     "New York Killzone",
     tooltip = "Interpreted in the Session Timezone.",
     group = GROUP_SESSIONS
)

bool requireKillzoneForRisk = input.bool(
     true,
     "Require Killzone for Risk Model",
     tooltip = "When enabled, educational risk levels only appear while a killzone is armed.",
     group = GROUP_SESSIONS
)


//====================================================================
// PREMIUM / DISCOUNT INPUTS
//====================================================================

bool showPremiumDiscount = input.bool(
     true,
     "Show Equilibrium Line",
     tooltip = "Equilibrium is the midpoint of the active confirmed swing high / low range.",
     group = GROUP_PD
)

bool showPremiumDiscountBg = input.bool(
     false,
     "Shade Premium / Discount",
     group = GROUP_PD
)

float equilibriumBandPct = input.float(
     5.0,
     "Equilibrium Band (%)",
     minval = 1.0,
     maxval = 20.0,
     step = 0.5,
     tooltip = "Percent of the active swing range treated as equilibrium (neither premium nor discount).",
     group = GROUP_PD
)

bool requirePdAlignForRisk = input.bool(
     true,
     "Require PD Align for Risk",
     tooltip = "Long risk model only in discount. Short risk model only in premium.",
     group = GROUP_PD
)


//====================================================================
// MULTI-TIMEFRAME INPUTS
//====================================================================

bool enableMtf = input.bool(
     true,
     "Enable Multi-Timeframe",
     tooltip = "Uses only completed higher-timeframe bars (non-repainting).",
     group = GROUP_MTF
)

string mtfTimeframeInput = input.timeframe(
     "60",
     "Higher Timeframe",
     tooltip = "Used when Profile = Custom. Confirmed HTF trend is compared against the chart timeframe trend and structure.",
     group = GROUP_MTF
)


//====================================================================
// CONFIDENCE INPUTS
//====================================================================

bool enableConfidence = input.bool(
     true,
     "Enable Confidence Engine",
     tooltip = "Scores confluence across trend, structure, MTF, OB, FVG, liquidity, and sessions. Not a win-rate forecast.",
     group = GROUP_CONFIDENCE
)

int confidenceAlertThresholdInput = input.int(
     70,
     "High Confidence Alert Threshold",
     minval = 1,
     maxval = 100,
     tooltip = "Used when Profile = Custom. Alerts fire when confidence crosses this level with a clear bullish or bearish direction.",
     group = GROUP_CONFIDENCE
)

int mtfConflictPenalty = input.int(
     15,
     "MTF Conflict Penalty",
     minval = 0,
     maxval = 40,
     tooltip = "Points subtracted from confidence when chart and HTF trends conflict.",
     group = GROUP_CONFIDENCE
)


//====================================================================
// RISK INPUTS
//====================================================================

bool enableRisk = input.bool(
     true,
     "Enable Risk Engine",
     tooltip = "Builds structure-based stop / target guidance from confirmed swings. Educational risk model only.",
     group = GROUP_RISK
)

bool showRiskLevels = input.bool(
     true,
     "Show SL / TP Levels",
     group = GROUP_RISK
)

float riskAtrBufferInput = input.float(
     0.15,
     "Stop ATR Buffer",
     minval = 0.0,
     step = 0.05,
     tooltip = "Used when Profile = Custom. Extra ATR distance beyond the confirmed swing used for the stop.",
     group = GROUP_RISK
)

float rewardRiskTp1Input = input.float(
     1.0,
     "TP1 Reward:Risk",
     minval = 0.5,
     step = 0.1,
     tooltip = "Used when Profile = Custom.",
     group = GROUP_RISK
)

float rewardRiskTp2Input = input.float(
     2.0,
     "TP2 Reward:Risk",
     minval = 0.5,
     step = 0.1,
     tooltip = "Used when Profile = Custom.",
     group = GROUP_RISK
)

int minConfidenceForRiskInput = input.int(
     60,
     "Min Confidence for Risk Model",
     minval = 0,
     maxval = 100,
     tooltip = "Used when Profile = Custom. Risk levels appear only when confidence reaches this score with a clear direction.",
     group = GROUP_RISK
)

float accountEquity = input.float(
     10000.0,
     "Account Equity",
     minval = 1.0,
     step = 100.0,
     tooltip = "Used only for suggested position-size math.",
     group = GROUP_RISK
)

float riskPercent = input.float(
     1.0,
     "Risk Percent",
     minval = 0.1,
     maxval = 10.0,
     step = 0.1,
     tooltip = "Percent of account equity risked if stop is hit.",
     group = GROUP_RISK
)


//====================================================================
// VISUAL INPUTS
//====================================================================

bool showBackground = input.bool(
     false,
     "Trend Background",
     group = GROUP_VISUALS
)

color bullishColor = input.color(
     color.rgb(0, 190, 120),
     "Bullish Color",
     group = GROUP_VISUALS
)

color bearishColor = input.color(
     color.rgb(230, 70, 70),
     "Bearish Color",
     group = GROUP_VISUALS
)

color neutralColor = input.color(
     color.rgb(140, 140, 140),
     "Neutral Color",
     group = GROUP_VISUALS
)


//====================================================================
// DASHBOARD INPUTS
//====================================================================

bool showDashboard = input.bool(
     true,
     "Show Dashboard",
     group = GROUP_DASHBOARD
)


//====================================================================
// PRESET RESOLUTION
//====================================================================
//
// Resolves runtime config from Profile selection.
// Custom -> manual inputs. Scalp / Intraday / Swing -> tuned packs.
//====================================================================

bool useCustomProfile = profilePreset == "Custom"
bool useScalpProfile = profilePreset == "Scalp"
bool useSwingProfile = profilePreset == "Swing"
// Intraday is the default non-custom pack.

int pivotLength =
     useCustomProfile ? pivotLengthInput :
     useScalpProfile ? 3 :
     useSwingProfile ? 8 :
     5

int obLookback =
     useCustomProfile ? obLookbackInput :
     useScalpProfile ? 12 :
     useSwingProfile ? 30 :
     20

int maxOrderBlocks =
     useCustomProfile ? maxOrderBlocksInput :
     useScalpProfile ? 6 :
     useSwingProfile ? 6 :
     8

float fvgMinAtrMult =
     useCustomProfile ? fvgMinAtrMultInput :
     useScalpProfile ? 0.0 :
     useSwingProfile ? 0.15 :
     0.05

int maxFairValueGaps =
     useCustomProfile ? maxFairValueGapsInput :
     useScalpProfile ? 10 :
     useSwingProfile ? 6 :
     8

bool fvgRequireStructureAlign =
     useCustomProfile ? fvgRequireStructureAlignInput :
     useSwingProfile

float liqToleranceAtrMult =
     useCustomProfile ? liqToleranceAtrMultInput :
     useScalpProfile ? 0.10 :
     useSwingProfile ? 0.20 :
     0.15

int maxLiquidityLevels =
     useCustomProfile ? maxLiquidityLevelsInput :
     useScalpProfile ? 10 :
     useSwingProfile ? 6 :
     8

int liqSwingHistory =
     useCustomProfile ? liqSwingHistoryInput :
     useScalpProfile ? 8 :
     useSwingProfile ? 16 :
     12

string mtfTimeframe =
     useCustomProfile ? mtfTimeframeInput :
     useScalpProfile ? "15" :
     useSwingProfile ? "240" :
     "60"

int confidenceAlertThreshold =
     useCustomProfile ? confidenceAlertThresholdInput :
     useScalpProfile ? 60 :
     useSwingProfile ? 75 :
     70

float riskAtrBuffer =
     useCustomProfile ? riskAtrBufferInput :
     useScalpProfile ? 0.10 :
     useSwingProfile ? 0.25 :
     0.15

float rewardRiskTp1 =
     useCustomProfile ? rewardRiskTp1Input :
     useScalpProfile ? 1.0 :
     useSwingProfile ? 1.5 :
     1.0

float rewardRiskTp2 =
     useCustomProfile ? rewardRiskTp2Input :
     useScalpProfile ? 1.5 :
     useSwingProfile ? 3.0 :
     2.0

int minConfidenceForRisk =
     useCustomProfile ? minConfidenceForRiskInput :
     useScalpProfile ? 55 :
     useSwingProfile ? 70 :
     60


//====================================================================
// EMA TREND ENGINE
//====================================================================

float emaFast   = ta.ema(close, fastEmaLength)
float emaMedium = ta.ema(close, mediumEmaLength)
float emaSlow   = ta.ema(close, slowEmaLength)

bool emaBullish =
     emaFast > emaMedium and
     emaMedium > emaSlow

bool emaBearish =
     emaFast < emaMedium and
     emaMedium < emaSlow

bool priceBullish =
     not usePriceFilter or
     close > emaSlow

bool priceBearish =
     not usePriceFilter or
     close < emaSlow

bool bullishTrend =
     emaBullish and
     priceBullish

bool bearishTrend =
     emaBearish and
     priceBearish


//====================================================================
// TREND STATE
//====================================================================
//
//  1 = Bullish
//  0 = Neutral
// -1 = Bearish
//====================================================================

int trendState =
     bullishTrend ? 1 :
     bearishTrend ? -1 :
     0

string trendText =
     trendState == 1 ? "BULLISH" :
     trendState == -1 ? "BEARISH" :
     "NEUTRAL"

color trendColor =
     trendState == 1 ? bullishColor :
     trendState == -1 ? bearishColor :
     neutralColor


//====================================================================
// EMA PLOTS
//====================================================================

plot(
     showEMAs ? emaFast : na,
     title = "Fast EMA",
     linewidth = 1,
     color = color.new(bullishColor, 0)
)

plot(
     showEMAs ? emaMedium : na,
     title = "Medium EMA",
     linewidth = 2,
     color = color.new(color.orange, 0)
)

plot(
     showEMAs ? emaSlow : na,
     title = "Slow EMA",
     linewidth = 2,
     color = color.new(bearishColor, 0)
)


//====================================================================
// OPTIONAL TREND BACKGROUND
//====================================================================

color backgroundColor =
     trendState == 1 ? color.new(bullishColor, 92) :
     trendState == -1 ? color.new(bearishColor, 92) :
     color.new(neutralColor, 96)

bgcolor(
     showBackground ? backgroundColor : na,
     title = "Trend Background"
)


//====================================================================
// SWING DETECTION
//====================================================================
//
// TradingView only confirms a pivot after `pivotLength` bars have
// appeared to its right.
//
// This introduces intentional confirmation delay while avoiding
// future-looking structure signals.
//====================================================================

float pivotHigh = ta.pivothigh(
     high,
     pivotLength,
     pivotLength
)

float pivotLow = ta.pivotlow(
     low,
     pivotLength,
     pivotLength
)

bool newPivotHigh = not na(pivotHigh)
bool newPivotLow  = not na(pivotLow)


//====================================================================
// SWING STATE STORAGE
//====================================================================
//
// Active swings drive BOS / CHoCH detection.
// Each confirmed swing may generate only one structure-break event.
//====================================================================

var float previousSwingHigh = na
var float previousSwingLow  = na

var float currentSwingHigh = na
var float currentSwingLow  = na

var float activeSwingHigh = na
var float activeSwingLow  = na

var int activeSwingHighBar = na
var int activeSwingLowBar  = na

var bool swingHighConsumed = true
var bool swingLowConsumed  = true

//  1 = Bullish structure
//  0 = Unset / bootstrap
// -1 = Bearish structure
var int structuralDirection = 0

var string lastHighType = "—"
var string lastLowType  = "—"

var string lastStructureEvent = "Waiting"
var string lastEvent = "—"

var line activeSwingHighLine = na
var line activeSwingLowLine  = na


//====================================================================
// HIGH STRUCTURE CLASSIFICATION
//====================================================================

if newPivotHigh

    currentSwingHigh := pivotHigh

    int pivotHighBar = bar_index - pivotLength

    string highType =
         na(previousSwingHigh) ? "H" :
         currentSwingHigh > previousSwingHigh ? "HH" :
         currentSwingHigh < previousSwingHigh ? "LH" :
         "EH"

    lastHighType := highType
    lastStructureEvent := highType

    // Activate this swing for a single future BOS / CHoCH.
    activeSwingHigh := pivotHigh
    activeSwingHighBar := pivotHighBar
    swingHighConsumed := false

    if showStructureLines
        if not na(activeSwingHighLine)
            line.set_extend(activeSwingHighLine, extend.none)
            line.set_x2(activeSwingHighLine, bar_index)

        activeSwingHighLine := line.new(
             pivotHighBar,
             pivotHigh,
             bar_index,
             pivotHigh,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dashed,
             color = color.new(bullishColor, 30),
             width = 1
        )

    if showStructureLabels

        label.new(
             pivotHighBar,
             pivotHigh,
             highType,
             style = label.style_label_down,
             color =
                 highType == "HH"
                     ? bullishColor
                     : highType == "LH"
                     ? bearishColor
                     : neutralColor,
             textcolor = color.white,
             size = size.tiny
        )

    previousSwingHigh := currentSwingHigh


//====================================================================
// LOW STRUCTURE CLASSIFICATION
//====================================================================

if newPivotLow

    currentSwingLow := pivotLow

    int pivotLowBar = bar_index - pivotLength

    string lowType =
         na(previousSwingLow) ? "L" :
         currentSwingLow > previousSwingLow ? "HL" :
         currentSwingLow < previousSwingLow ? "LL" :
         "EL"

    lastLowType := lowType
    lastStructureEvent := lowType

    // Activate this swing for a single future BOS / CHoCH.
    activeSwingLow := pivotLow
    activeSwingLowBar := pivotLowBar
    swingLowConsumed := false

    if showStructureLines
        if not na(activeSwingLowLine)
            line.set_extend(activeSwingLowLine, extend.none)
            line.set_x2(activeSwingLowLine, bar_index)

        activeSwingLowLine := line.new(
             pivotLowBar,
             pivotLow,
             bar_index,
             pivotLow,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dashed,
             color = color.new(bearishColor, 30),
             width = 1
        )

    if showStructureLabels

        label.new(
             pivotLowBar,
             pivotLow,
             lowType,
             style = label.style_label_up,
             color =
                 lowType == "HL"
                     ? bullishColor
                     : lowType == "LL"
                     ? bearishColor
                     : neutralColor,
             textcolor = color.white,
             size = size.tiny
        )

    previousSwingLow := currentSwingLow


//====================================================================
// STRUCTURE BIAS
//====================================================================
//
// Bullish structure:
// HH + HL
//
// Bearish structure:
// LH + LL
//
// Anything else is treated as Mixed.
//
// Note: structuralDirection (BOS / CHoCH) is tracked separately and
// does not redefine this Phase 1 HH / HL bias.
//====================================================================

bool bullishStructure =
     lastHighType == "HH" and
     lastLowType == "HL"

bool bearishStructure =
     lastHighType == "LH" and
     lastLowType == "LL"

string structureText =
     bullishStructure ? "BULLISH" :
     bearishStructure ? "BEARISH" :
     "MIXED"

color structureColor =
     bullishStructure ? bullishColor :
     bearishStructure ? bearishColor :
     neutralColor


//====================================================================
// STRUCTURE BREAK DETECTION
//====================================================================
//
// A break requires a confirmed bar close beyond an active, unconsumed
// swing. Intrabar wicks never generate events.
//====================================================================

bool bullishBreak =
     barstate.isconfirmed and
     not swingHighConsumed and
     not na(activeSwingHigh) and
     close > activeSwingHigh

bool bearishBreak =
     barstate.isconfirmed and
     not swingLowConsumed and
     not na(activeSwingLow) and
     close < activeSwingLow


//====================================================================
// BOS ENGINE + CHOCH ENGINE
//====================================================================
//
// Shared break detection above; classification below.
//
// Classification:
// - Bullish break + direction bullish or unset  -> Bullish BOS
// - Bullish break + direction bearish           -> Bullish CHoCH
// - Bearish break + direction bearish or unset  -> Bearish BOS
// - Bearish break + direction bullish           -> Bearish CHoCH
//
// Same-bar dual break order:
// 1) Prefer any CHoCH (structure flip) first
// 2) Otherwise process bullish break, then bearish break
//====================================================================

bool bullishBosEvent   = false
bool bearishBosEvent   = false
bool bullishChochEvent = false
bool bearishChochEvent = false

// Resolve same-bar priority into an ordered pair of actions.
bool runBullishBreak = false
bool runBearishBreak = false

if bullishBreak and bearishBreak
    bool bullishIsChoch = structuralDirection == -1
    bool bearishIsChoch = structuralDirection == 1

    if bullishIsChoch and not bearishIsChoch
        runBullishBreak := true
    else if bearishIsChoch and not bullishIsChoch
        runBearishBreak := true
    else
        runBullishBreak := true
        runBearishBreak := true
else if bullishBreak
    runBullishBreak := true
else if bearishBreak
    runBearishBreak := true

if runBullishBreak
    bool isBullishChoch = structuralDirection == -1
    string bullishEventName = isBullishChoch ? "Bullish CHoCH" : "Bullish BOS"

    swingHighConsumed := true
    structuralDirection := 1
    lastEvent := bullishEventName
    lastStructureEvent := bullishEventName

    if isBullishChoch
        bullishChochEvent := true
    else
        bullishBosEvent := true

    if showStructureLines and not na(activeSwingHighLine)
        line.set_extend(activeSwingHighLine, extend.none)
        line.set_x2(activeSwingHighLine, bar_index)

    if showBosChochLabels
        label.new(
             bar_index,
             high,
             bullishEventName,
             style = label.style_label_up,
             color = bullishColor,
             textcolor = color.white,
             size = size.tiny
        )

// Re-check swingLowConsumed so a same-bar bullish event cannot
// double-fire a low that was somehow already consumed.
if runBearishBreak and not swingLowConsumed
    bool isBearishChoch = structuralDirection == 1
    string bearishEventName = isBearishChoch ? "Bearish CHoCH" : "Bearish BOS"

    swingLowConsumed := true
    structuralDirection := -1
    lastEvent := bearishEventName
    lastStructureEvent := bearishEventName

    if isBearishChoch
        bearishChochEvent := true
    else
        bearishBosEvent := true

    if showStructureLines and not na(activeSwingLowLine)
        line.set_extend(activeSwingLowLine, extend.none)
        line.set_x2(activeSwingLowLine, bar_index)

    if showBosChochLabels
        label.new(
             bar_index,
             low,
             bearishEventName,
             style = label.style_label_down,
             color = bearishColor,
             textcolor = color.white,
             size = size.tiny
        )


//====================================================================
// ORDER BLOCK ENGINE
//====================================================================
//
// Bullish OB:
// Last bearish candle before a confirmed bullish BOS / CHoCH.
//
// Bearish OB:
// Last bullish candle before a confirmed bearish BOS / CHoCH.
//
// Lifecycle:
// - Created only when a confirmed structure-break event fires
// - Mitigated when price revisits the OB zone
// - Invalidated when a confirmed close trades through the OB
//
// Non-repainting:
// Creation is gated by Phase 2 confirmed events. Candle search uses
// historical offsets only (no future bars).
//====================================================================

var array<box>   obBoxes       = array.new_box()
var array<int>   obDirections  = array.new_int()
var array<float> obTops        = array.new_float()
var array<float> obBottoms     = array.new_float()
var array<bool>  obMitigated   = array.new_bool()
var array<int>   obCreatedBars = array.new_int()

var string lastObEvent = "—"

bool bullishObCreatedEvent     = false
bool bearishObCreatedEvent     = false
bool bullishObMitigatedEvent   = false
bool bearishObMitigatedEvent   = false
bool bullishObInvalidatedEvent = false
bool bearishObInvalidatedEvent = false

// Breaker state (populated when OBs invalidate / fail).
var array<box>   breakerBoxes       = array.new_box()
var array<int>   breakerDirections  = array.new_int()
var array<float> breakerTops        = array.new_float()
var array<float> breakerBottoms     = array.new_float()
var array<bool>  breakerMitigated   = array.new_bool()
var array<int>   breakerCreatedBars = array.new_int()

var string lastBreakerEvent = "—"

bool bullishBreakerCreatedEvent   = false
bool bearishBreakerCreatedEvent   = false
bool bullishBreakerMitigatedEvent = false
bool bearishBreakerMitigatedEvent = false
bool bullishBreakerFilledEvent    = false
bool bearishBreakerFilledEvent    = false

createBreakerBlock(float zoneTop, float zoneBottom, int breakerDirection) =>
    box breakerBox = na
    if showBreakerBlocks
        color breakerColor = breakerDirection == 1 ? bullishColor : bearishColor
        breakerBox := box.new(
             bar_index,
             zoneTop,
             bar_index,
             zoneBottom,
             xloc = xloc.bar_index,
             border_color = color.new(breakerColor, 10),
             border_width = 2,
             bgcolor = color.new(breakerColor, 80),
             extend = extend.none
        )

    array.push(breakerBoxes, breakerBox)
    array.push(breakerDirections, breakerDirection)
    array.push(breakerTops, zoneTop)
    array.push(breakerBottoms, zoneBottom)
    array.push(breakerMitigated, false)
    array.push(breakerCreatedBars, bar_index)

    while array.size(breakerBoxes) > maxBreakerBlocks
        box oldBreaker = array.get(breakerBoxes, 0)
        if not na(oldBreaker)
            box.delete(oldBreaker)
        array.remove(breakerBoxes, 0)
        array.remove(breakerDirections, 0)
        array.remove(breakerTops, 0)
        array.remove(breakerBottoms, 0)
        array.remove(breakerMitigated, 0)
        array.remove(breakerCreatedBars, 0)

    breakerDirection == 1 ? "Bullish Breaker" : "Bearish Breaker"

// Returns bars-ago offset of the most recent opposing candle.
// wantBearishCandle = true  -> last down-close candle (bullish OB source)
// wantBearishCandle = false -> last up-close candle (bearish OB source)
findOpposingCandleOffset(bool wantBearishCandle, int lookbackBars) =>
    int foundOffset = na
    for i = 1 to lookbackBars
        bool isBearishCandle = close[i] < open[i]
        bool isBullishCandle = close[i] > open[i]
        if wantBearishCandle and isBearishCandle
            foundOffset := i
            break
        if not wantBearishCandle and isBullishCandle
            foundOffset := i
            break
    foundOffset

bool bullishStructureBreakEvent =
     bullishBosEvent or
     (createObFromChoch and bullishChochEvent)

bool bearishStructureBreakEvent =
     bearishBosEvent or
     (createObFromChoch and bearishChochEvent)

if bullishStructureBreakEvent
    int bullishObOffset = findOpposingCandleOffset(true, obLookback)

    if not na(bullishObOffset)
        float bullishZoneTop = high[bullishObOffset]
        float bullishZoneBottom = low[bullishObOffset]
        int bullishZoneStart = bar_index - bullishObOffset

        box bullishObBox = na
        if showOrderBlocks
            bullishObBox := box.new(
                 bullishZoneStart,
                 bullishZoneTop,
                 bar_index,
                 bullishZoneBottom,
                 xloc = xloc.bar_index,
                 border_color = color.new(bullishColor, 20),
                 border_width = 1,
                 bgcolor = color.new(bullishColor, 85),
                 extend = extend.none
            )

        array.push(obBoxes, bullishObBox)
        array.push(obDirections, 1)
        array.push(obTops, bullishZoneTop)
        array.push(obBottoms, bullishZoneBottom)
        array.push(obMitigated, false)
        array.push(obCreatedBars, bar_index)

        while array.size(obBoxes) > maxOrderBlocks
            box oldBox = array.get(obBoxes, 0)
            if not na(oldBox)
                box.delete(oldBox)
            array.remove(obBoxes, 0)
            array.remove(obDirections, 0)
            array.remove(obTops, 0)
            array.remove(obBottoms, 0)
            array.remove(obMitigated, 0)
            array.remove(obCreatedBars, 0)

        lastObEvent := "Bullish OB"
        bullishObCreatedEvent := true

if bearishStructureBreakEvent
    int bearishObOffset = findOpposingCandleOffset(false, obLookback)

    if not na(bearishObOffset)
        float bearishZoneTop = high[bearishObOffset]
        float bearishZoneBottom = low[bearishObOffset]
        int bearishZoneStart = bar_index - bearishObOffset

        box bearishObBox = na
        if showOrderBlocks
            bearishObBox := box.new(
                 bearishZoneStart,
                 bearishZoneTop,
                 bar_index,
                 bearishZoneBottom,
                 xloc = xloc.bar_index,
                 border_color = color.new(bearishColor, 20),
                 border_width = 1,
                 bgcolor = color.new(bearishColor, 85),
                 extend = extend.none
            )

        array.push(obBoxes, bearishObBox)
        array.push(obDirections, -1)
        array.push(obTops, bearishZoneTop)
        array.push(obBottoms, bearishZoneBottom)
        array.push(obMitigated, false)
        array.push(obCreatedBars, bar_index)

        while array.size(obBoxes) > maxOrderBlocks
            box oldBox = array.get(obBoxes, 0)
            if not na(oldBox)
                box.delete(oldBox)
            array.remove(obBoxes, 0)
            array.remove(obDirections, 0)
            array.remove(obTops, 0)
            array.remove(obBottoms, 0)
            array.remove(obMitigated, 0)
            array.remove(obCreatedBars, 0)

        lastObEvent := "Bearish OB"
        bearishObCreatedEvent := true

// Extend, mitigate, and invalidate active order blocks on confirmed bars.
// Mitigation / invalidation start on the bar AFTER creation so the
// displacement candle that printed the BOS / CHoCH cannot instantly
// mitigate its own order block.
if barstate.isconfirmed and array.size(obBoxes) > 0
    for i = array.size(obBoxes) - 1 to 0
        box activeBox = array.get(obBoxes, i)
        int direction = array.get(obDirections, i)
        float zoneTop = array.get(obTops, i)
        float zoneBottom = array.get(obBottoms, i)
        bool alreadyMitigated = array.get(obMitigated, i)
        int createdBar = array.get(obCreatedBars, i)

        if not na(activeBox)
            box.set_right(activeBox, bar_index)

        if bar_index > createdBar
            bool isBullishOb = direction == 1
            bool invalidated =
                 isBullishOb ? close < zoneBottom : close > zoneTop

            if invalidated
                // Failed OB flips into an opposite breaker block.
                int breakerDirection = isBullishOb ? -1 : 1
                string breakerName = createBreakerBlock(zoneTop, zoneBottom, breakerDirection)
                lastBreakerEvent := breakerName

                if breakerDirection == 1
                    bullishBreakerCreatedEvent := true
                else
                    bearishBreakerCreatedEvent := true

                if isBullishOb
                    bullishObInvalidatedEvent := true
                else
                    bearishObInvalidatedEvent := true

                if not na(activeBox)
                    box.delete(activeBox)
                array.remove(obBoxes, i)
                array.remove(obDirections, i)
                array.remove(obTops, i)
                array.remove(obBottoms, i)
                array.remove(obMitigated, i)
                array.remove(obCreatedBars, i)
            else
                bool priceEnteredZone = high >= zoneBottom and low <= zoneTop

                if not alreadyMitigated and priceEnteredZone
                    array.set(obMitigated, i, true)

                    if isBullishOb
                        bullishObMitigatedEvent := true
                    else
                        bearishObMitigatedEvent := true

                    if keepMitigatedOrderBlocks
                        if not na(activeBox)
                            color mutedColor = isBullishOb ? bullishColor : bearishColor
                            box.set_bgcolor(activeBox, color.new(mutedColor, 93))
                            box.set_border_color(activeBox, color.new(mutedColor, 55))
                    else
                        if not na(activeBox)
                            box.delete(activeBox)
                        array.remove(obBoxes, i)
                        array.remove(obDirections, i)
                        array.remove(obTops, i)
                        array.remove(obBottoms, i)
                        array.remove(obMitigated, i)
                        array.remove(obCreatedBars, i)


//====================================================================
// BREAKER BLOCK ENGINE
//====================================================================
//
// A breaker is created when an order block fails (confirmed close
// through its far side). Direction flips:
// - Failed bullish OB  -> Bearish Breaker
// - Failed bearish OB  -> Bullish Breaker
//
// Lifecycle mirrors OBs: mitigate on revisit, fill on close-through.
//====================================================================

if barstate.isconfirmed and array.size(breakerBoxes) > 0
    for i = array.size(breakerBoxes) - 1 to 0
        box activeBreaker = array.get(breakerBoxes, i)
        int breakerDir = array.get(breakerDirections, i)
        float breakerTop = array.get(breakerTops, i)
        float breakerBottom = array.get(breakerBottoms, i)
        bool breakerAlreadyMitigated = array.get(breakerMitigated, i)
        int breakerCreatedBar = array.get(breakerCreatedBars, i)

        if not na(activeBreaker)
            box.set_right(activeBreaker, bar_index)

        if bar_index > breakerCreatedBar
            bool isBullishBreaker = breakerDir == 1
            bool breakerFilled =
                 isBullishBreaker ? close < breakerBottom : close > breakerTop

            if breakerFilled
                if isBullishBreaker
                    bullishBreakerFilledEvent := true
                else
                    bearishBreakerFilledEvent := true

                if not na(activeBreaker)
                    box.delete(activeBreaker)
                array.remove(breakerBoxes, i)
                array.remove(breakerDirections, i)
                array.remove(breakerTops, i)
                array.remove(breakerBottoms, i)
                array.remove(breakerMitigated, i)
                array.remove(breakerCreatedBars, i)
            else
                bool enteredBreaker = high >= breakerBottom and low <= breakerTop

                if not breakerAlreadyMitigated and enteredBreaker
                    array.set(breakerMitigated, i, true)

                    if isBullishBreaker
                        bullishBreakerMitigatedEvent := true
                    else
                        bearishBreakerMitigatedEvent := true

                    if keepMitigatedBreakers
                        if not na(activeBreaker)
                            color mutedBreaker = isBullishBreaker ? bullishColor : bearishColor
                            box.set_bgcolor(activeBreaker, color.new(mutedBreaker, 92))
                            box.set_border_color(activeBreaker, color.new(mutedBreaker, 45))
                    else
                        if not na(activeBreaker)
                            box.delete(activeBreaker)
                        array.remove(breakerBoxes, i)
                        array.remove(breakerDirections, i)
                        array.remove(breakerTops, i)
                        array.remove(breakerBottoms, i)
                        array.remove(breakerMitigated, i)
                        array.remove(breakerCreatedBars, i)


//====================================================================
// FAIR VALUE GAP ENGINE
//====================================================================
//
// Classic 3-candle imbalance on a confirmed bar:
// - Bullish FVG: low > high[2]
// - Bearish FVG: high < low[2]
//
// Zone:
// - Bullish: [high[2], low]
// - Bearish: [high, low[2]]
//
// Lifecycle:
// - Mitigated when price revisits the gap after creation
// - Filled / removed when price trades through the far side of the gap
//
// Non-repainting:
// Detection requires barstate.isconfirmed so candle 3 is closed.
//====================================================================

var array<box>   fvgBoxes       = array.new_box()
var array<int>   fvgDirections  = array.new_int()
var array<float> fvgTops        = array.new_float()
var array<float> fvgBottoms     = array.new_float()
var array<bool>  fvgMitigated   = array.new_bool()
var array<int>   fvgCreatedBars = array.new_int()

var string lastFvgEvent = "—"

bool bullishFvgCreatedEvent   = false
bool bearishFvgCreatedEvent   = false
bool bullishFvgMitigatedEvent = false
bool bearishFvgMitigatedEvent = false
bool bullishFvgFilledEvent    = false
bool bearishFvgFilledEvent    = false

float fvgAtr = ta.atr(14)

bool bullishFvgSignal =
     barstate.isconfirmed and
     low > high[2]

bool bearishFvgSignal =
     barstate.isconfirmed and
     high < low[2]

if bullishFvgSignal
    float bullishFvgTop = low
    float bullishFvgBottom = high[2]
    float bullishGapSize = bullishFvgTop - bullishFvgBottom

    bool bullishSizeOk =
         fvgMinAtrMult <= 0.0 or
         bullishGapSize >= fvgAtr * fvgMinAtrMult

    bool bullishAlignOk =
         not fvgRequireStructureAlign or
         structuralDirection >= 0

    if bullishSizeOk and bullishAlignOk and bullishGapSize > 0
        box bullishFvgBox = na
        if showFairValueGaps
            bullishFvgBox := box.new(
                 bar_index - 2,
                 bullishFvgTop,
                 bar_index,
                 bullishFvgBottom,
                 xloc = xloc.bar_index,
                 border_color = color.new(bullishColor, 35),
                 border_width = 1,
                 bgcolor = color.new(bullishColor, 88),
                 extend = extend.none
            )

        array.push(fvgBoxes, bullishFvgBox)
        array.push(fvgDirections, 1)
        array.push(fvgTops, bullishFvgTop)
        array.push(fvgBottoms, bullishFvgBottom)
        array.push(fvgMitigated, false)
        array.push(fvgCreatedBars, bar_index)

        while array.size(fvgBoxes) > maxFairValueGaps
            box oldFvgBox = array.get(fvgBoxes, 0)
            if not na(oldFvgBox)
                box.delete(oldFvgBox)
            array.remove(fvgBoxes, 0)
            array.remove(fvgDirections, 0)
            array.remove(fvgTops, 0)
            array.remove(fvgBottoms, 0)
            array.remove(fvgMitigated, 0)
            array.remove(fvgCreatedBars, 0)

        lastFvgEvent := "Bullish FVG"
        bullishFvgCreatedEvent := true

if bearishFvgSignal
    float bearishFvgTop = low[2]
    float bearishFvgBottom = high
    float bearishGapSize = bearishFvgTop - bearishFvgBottom

    bool bearishSizeOk =
         fvgMinAtrMult <= 0.0 or
         bearishGapSize >= fvgAtr * fvgMinAtrMult

    bool bearishAlignOk =
         not fvgRequireStructureAlign or
         structuralDirection <= 0

    if bearishSizeOk and bearishAlignOk and bearishGapSize > 0
        box bearishFvgBox = na
        if showFairValueGaps
            bearishFvgBox := box.new(
                 bar_index - 2,
                 bearishFvgTop,
                 bar_index,
                 bearishFvgBottom,
                 xloc = xloc.bar_index,
                 border_color = color.new(bearishColor, 35),
                 border_width = 1,
                 bgcolor = color.new(bearishColor, 88),
                 extend = extend.none
            )

        array.push(fvgBoxes, bearishFvgBox)
        array.push(fvgDirections, -1)
        array.push(fvgTops, bearishFvgTop)
        array.push(fvgBottoms, bearishFvgBottom)
        array.push(fvgMitigated, false)
        array.push(fvgCreatedBars, bar_index)

        while array.size(fvgBoxes) > maxFairValueGaps
            box oldFvgBox = array.get(fvgBoxes, 0)
            if not na(oldFvgBox)
                box.delete(oldFvgBox)
            array.remove(fvgBoxes, 0)
            array.remove(fvgDirections, 0)
            array.remove(fvgTops, 0)
            array.remove(fvgBottoms, 0)
            array.remove(fvgMitigated, 0)
            array.remove(fvgCreatedBars, 0)

        lastFvgEvent := "Bearish FVG"
        bearishFvgCreatedEvent := true

// Extend, mitigate, and fill active FVGs on confirmed bars.
if barstate.isconfirmed and array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        box activeFvgBox = array.get(fvgBoxes, i)
        int fvgDirection = array.get(fvgDirections, i)
        float fvgTop = array.get(fvgTops, i)
        float fvgBottom = array.get(fvgBottoms, i)
        bool fvgAlreadyMitigated = array.get(fvgMitigated, i)
        int fvgCreatedBar = array.get(fvgCreatedBars, i)

        if not na(activeFvgBox)
            box.set_right(activeFvgBox, bar_index)

        if bar_index > fvgCreatedBar
            bool isBullishFvg = fvgDirection == 1

            // Full fill: price trades through the far side of the imbalance.
            bool fullyFilled =
                 isBullishFvg ? low <= fvgBottom : high >= fvgTop

            if fullyFilled
                if isBullishFvg
                    bullishFvgFilledEvent := true
                else
                    bearishFvgFilledEvent := true

                if not na(activeFvgBox)
                    box.delete(activeFvgBox)
                array.remove(fvgBoxes, i)
                array.remove(fvgDirections, i)
                array.remove(fvgTops, i)
                array.remove(fvgBottoms, i)
                array.remove(fvgMitigated, i)
                array.remove(fvgCreatedBars, i)
            else
                bool priceEnteredFvg = high >= fvgBottom and low <= fvgTop

                if not fvgAlreadyMitigated and priceEnteredFvg
                    array.set(fvgMitigated, i, true)

                    if isBullishFvg
                        bullishFvgMitigatedEvent := true
                    else
                        bearishFvgMitigatedEvent := true

                    if keepMitigatedFvg
                        if not na(activeFvgBox)
                            color mutedFvgColor = isBullishFvg ? bullishColor : bearishColor
                            box.set_bgcolor(activeFvgBox, color.new(mutedFvgColor, 94))
                            box.set_border_color(activeFvgBox, color.new(mutedFvgColor, 60))
                    else
                        if not na(activeFvgBox)
                            box.delete(activeFvgBox)
                        array.remove(fvgBoxes, i)
                        array.remove(fvgDirections, i)
                        array.remove(fvgTops, i)
                        array.remove(fvgBottoms, i)
                        array.remove(fvgMitigated, i)
                        array.remove(fvgCreatedBars, i)


//====================================================================
// LIQUIDITY ENGINE
//====================================================================
//
// Equal High (EQH / buy-side liquidity):
// Two confirmed swing highs within ATR tolerance.
//
// Equal Low (EQL / sell-side liquidity):
// Two confirmed swing lows within ATR tolerance.
//
// Sweep (confirmed bar only):
// - EQH Sweep: high > level and close < level
// - EQL Sweep: low < level and close > level
//
// Each pool may be swept only once.
//
// Non-repainting:
// Pools use confirmed pivots. Sweeps require barstate.isconfirmed
// and a reclaim close back inside the level.
//====================================================================

var array<float> liqSwingHighPrices = array.new_float()
var array<int>   liqSwingHighBars   = array.new_int()
var array<float> liqSwingLowPrices  = array.new_float()
var array<int>   liqSwingLowBars    = array.new_int()

var array<line>  liqLines      = array.new_line()
var array<label> liqLabels     = array.new_label()
var array<float> liqLevels     = array.new_float()
var array<int>   liqDirections = array.new_int()
var array<bool>  liqSwept      = array.new_bool()
var array<int>   liqStartBars  = array.new_int()

var string lastLiquidityEvent = "—"

bool eqhFormedEvent = false
bool eqlFormedEvent = false
bool eqhSweepEvent  = false
bool eqlSweepEvent  = false

float liqAtr = ta.atr(14)
float liqTolerance = liqAtr * liqToleranceAtrMult

// Returns index of an unswept pool near level+direction, or -1.
findNearbyLiquidityIndex(float level, int direction) =>
    int foundIndex = -1
    if array.size(liqLevels) > 0
        for i = 0 to array.size(liqLevels) - 1
            bool sameDirection = array.get(liqDirections, i) == direction
            bool nearby = math.abs(array.get(liqLevels, i) - level) <= liqTolerance
            bool unswept = not array.get(liqSwept, i)
            if sameDirection and nearby and unswept
                foundIndex := i
                break
    foundIndex

if newPivotHigh
    array.push(liqSwingHighPrices, pivotHigh)
    array.push(liqSwingHighBars, bar_index - pivotLength)

    while array.size(liqSwingHighPrices) > liqSwingHistory
        array.remove(liqSwingHighPrices, 0)
        array.remove(liqSwingHighBars, 0)

    if array.size(liqSwingHighPrices) >= 2
        float newestHigh = array.get(liqSwingHighPrices, array.size(liqSwingHighPrices) - 1)
        int newestHighBar = array.get(liqSwingHighBars, array.size(liqSwingHighBars) - 1)

        for i = 0 to array.size(liqSwingHighPrices) - 2
            float priorHigh = array.get(liqSwingHighPrices, i)
            int priorHighBar = array.get(liqSwingHighBars, i)

            if math.abs(newestHigh - priorHigh) <= liqTolerance
                float eqhLevel = math.max(newestHigh, priorHigh)
                int eqhStartBar = math.min(newestHighBar, priorHighBar)
                int existingEqh = findNearbyLiquidityIndex(eqhLevel, 1)

                if existingEqh >= 0
                    float mergedEqh = math.max(eqhLevel, array.get(liqLevels, existingEqh))
                    array.set(liqLevels, existingEqh, mergedEqh)
                    array.set(liqStartBars, existingEqh, math.min(eqhStartBar, array.get(liqStartBars, existingEqh)))

                    line existingEqhLine = array.get(liqLines, existingEqh)
                    if not na(existingEqhLine)
                        line.set_y1(existingEqhLine, mergedEqh)
                        line.set_y2(existingEqhLine, mergedEqh)
                        line.set_x1(existingEqhLine, array.get(liqStartBars, existingEqh))
                        line.set_x2(existingEqhLine, bar_index)
                        line.set_extend(existingEqhLine, extend.right)

                    label existingEqhLabel = array.get(liqLabels, existingEqh)
                    if not na(existingEqhLabel)
                        label.set_xy(existingEqhLabel, array.get(liqStartBars, existingEqh), mergedEqh)
                else
                    line eqhLine = na
                    label eqhTag = na

                    if showLiquidity
                        eqhLine := line.new(
                             eqhStartBar,
                             eqhLevel,
                             bar_index,
                             eqhLevel,
                             xloc = xloc.bar_index,
                             extend = extend.right,
                             style = line.style_dotted,
                             color = color.new(bearishColor, 25),
                             width = 1
                        )

                        if showLiquidityLabels
                            eqhTag := label.new(
                                 eqhStartBar,
                                 eqhLevel,
                                 "EQH",
                                 style = label.style_label_down,
                                 color = color.new(bearishColor, 20),
                                 textcolor = color.white,
                                 size = size.tiny
                            )

                    array.push(liqLines, eqhLine)
                    array.push(liqLabels, eqhTag)
                    array.push(liqLevels, eqhLevel)
                    array.push(liqDirections, 1)
                    array.push(liqSwept, false)
                    array.push(liqStartBars, eqhStartBar)

                    while array.size(liqLevels) > maxLiquidityLevels
                        line oldLiqLine = array.get(liqLines, 0)
                        label oldLiqLabel = array.get(liqLabels, 0)
                        if not na(oldLiqLine)
                            line.delete(oldLiqLine)
                        if not na(oldLiqLabel)
                            label.delete(oldLiqLabel)
                        array.remove(liqLines, 0)
                        array.remove(liqLabels, 0)
                        array.remove(liqLevels, 0)
                        array.remove(liqDirections, 0)
                        array.remove(liqSwept, 0)
                        array.remove(liqStartBars, 0)

                    lastLiquidityEvent := "EQH"
                    eqhFormedEvent := true

                break

if newPivotLow
    array.push(liqSwingLowPrices, pivotLow)
    array.push(liqSwingLowBars, bar_index - pivotLength)

    while array.size(liqSwingLowPrices) > liqSwingHistory
        array.remove(liqSwingLowPrices, 0)
        array.remove(liqSwingLowBars, 0)

    if array.size(liqSwingLowPrices) >= 2
        float newestLow = array.get(liqSwingLowPrices, array.size(liqSwingLowPrices) - 1)
        int newestLowBar = array.get(liqSwingLowBars, array.size(liqSwingLowBars) - 1)

        for i = 0 to array.size(liqSwingLowPrices) - 2
            float priorLow = array.get(liqSwingLowPrices, i)
            int priorLowBar = array.get(liqSwingLowBars, i)

            if math.abs(newestLow - priorLow) <= liqTolerance
                float eqlLevel = math.min(newestLow, priorLow)
                int eqlStartBar = math.min(newestLowBar, priorLowBar)
                int existingEql = findNearbyLiquidityIndex(eqlLevel, -1)

                if existingEql >= 0
                    float mergedEql = math.min(eqlLevel, array.get(liqLevels, existingEql))
                    array.set(liqLevels, existingEql, mergedEql)
                    array.set(liqStartBars, existingEql, math.min(eqlStartBar, array.get(liqStartBars, existingEql)))

                    line existingEqlLine = array.get(liqLines, existingEql)
                    if not na(existingEqlLine)
                        line.set_y1(existingEqlLine, mergedEql)
                        line.set_y2(existingEqlLine, mergedEql)
                        line.set_x1(existingEqlLine, array.get(liqStartBars, existingEql))
                        line.set_x2(existingEqlLine, bar_index)
                        line.set_extend(existingEqlLine, extend.right)

                    label existingEqlLabel = array.get(liqLabels, existingEql)
                    if not na(existingEqlLabel)
                        label.set_xy(existingEqlLabel, array.get(liqStartBars, existingEql), mergedEql)
                else
                    line eqlLine = na
                    label eqlTag = na

                    if showLiquidity
                        eqlLine := line.new(
                             eqlStartBar,
                             eqlLevel,
                             bar_index,
                             eqlLevel,
                             xloc = xloc.bar_index,
                             extend = extend.right,
                             style = line.style_dotted,
                             color = color.new(bullishColor, 25),
                             width = 1
                        )

                        if showLiquidityLabels
                            eqlTag := label.new(
                                 eqlStartBar,
                                 eqlLevel,
                                 "EQL",
                                 style = label.style_label_up,
                                 color = color.new(bullishColor, 20),
                                 textcolor = color.white,
                                 size = size.tiny
                            )

                    array.push(liqLines, eqlLine)
                    array.push(liqLabels, eqlTag)
                    array.push(liqLevels, eqlLevel)
                    array.push(liqDirections, -1)
                    array.push(liqSwept, false)
                    array.push(liqStartBars, eqlStartBar)

                    while array.size(liqLevels) > maxLiquidityLevels
                        line oldLiqLine = array.get(liqLines, 0)
                        label oldLiqLabel = array.get(liqLabels, 0)
                        if not na(oldLiqLine)
                            line.delete(oldLiqLine)
                        if not na(oldLiqLabel)
                            label.delete(oldLiqLabel)
                        array.remove(liqLines, 0)
                        array.remove(liqLabels, 0)
                        array.remove(liqLevels, 0)
                        array.remove(liqDirections, 0)
                        array.remove(liqSwept, 0)
                        array.remove(liqStartBars, 0)

                    lastLiquidityEvent := "EQL"
                    eqlFormedEvent := true

                break

// Extend unswept liquidity lines and detect confirmed sweeps.
if barstate.isconfirmed and array.size(liqLevels) > 0
    for i = array.size(liqLevels) - 1 to 0
        bool alreadySwept = array.get(liqSwept, i)
        float level = array.get(liqLevels, i)
        int direction = array.get(liqDirections, i)
        line liqLine = array.get(liqLines, i)

        if not alreadySwept
            if not na(liqLine)
                line.set_x2(liqLine, bar_index)

            // direction 1 = EQH / buy-side liquidity above highs
            // direction -1 = EQL / sell-side liquidity below lows
            bool sweptEqh = direction == 1 and high > level and close < level
            bool sweptEql = direction == -1 and low < level and close > level

            if sweptEqh or sweptEql
                array.set(liqSwept, i, true)

                if not na(liqLine)
                    line.set_extend(liqLine, extend.none)
                    line.set_x2(liqLine, bar_index)
                    line.set_style(liqLine, line.style_dashed)
                    line.set_color(
                         liqLine,
                         color.new(neutralColor, 35)
                    )

                if sweptEqh
                    lastLiquidityEvent := "EQH Sweep"
                    eqhSweepEvent := true

                    if showSweepLabels
                        label.new(
                             bar_index,
                             high,
                             "EQH Sweep",
                             style = label.style_label_down,
                             color = color.new(bearishColor, 10),
                             textcolor = color.white,
                             size = size.tiny
                        )
                else
                    lastLiquidityEvent := "EQL Sweep"
                    eqlSweepEvent := true

                    if showSweepLabels
                        label.new(
                             bar_index,
                             low,
                             "EQL Sweep",
                             style = label.style_label_up,
                             color = color.new(bullishColor, 10),
                             textcolor = color.white,
                             size = size.tiny
                        )


//====================================================================
// SESSION ENGINE
//====================================================================
//
// Tracks Asian / London / New York session ranges.
//
// Rules:
// - Range high / low update only on confirmed bars while inside session
// - Range locks when the session ends
// - Session high / low breaks use confirmed closes beyond locked levels
//
// Non-repainting:
// Active ranges do not use intrabar provisional extremes.
// Breaks require barstate.isconfirmed.
//====================================================================

color asianSessionColor    = color.rgb(70, 130, 180)
color londonSessionColor   = color.rgb(210, 160, 60)
color newYorkSessionColor  = color.rgb(90, 160, 140)

string resolvedSessionTimezone =
     sessionTimezone == "Exchange" ? syminfo.timezone : sessionTimezone

bool inAsianSession =
     showAsianSession and
     not na(time(timeframe.period, asianSessionInput, resolvedSessionTimezone))

bool inLondonSession =
     showLondonSession and
     not na(time(timeframe.period, londonSessionInput, resolvedSessionTimezone))

bool inNewYorkSession =
     showNewYorkSession and
     not na(time(timeframe.period, newYorkSessionInput, resolvedSessionTimezone))

bool inLondonKillzone =
     enableKillzoneArming and
     not na(time(timeframe.period, londonKillzoneInput, resolvedSessionTimezone))

bool inNewYorkKillzone =
     enableKillzoneArming and
     not na(time(timeframe.period, newYorkKillzoneInput, resolvedSessionTimezone))

bool killzoneArmed =
     enableKillzoneArming and
     (inLondonKillzone or inNewYorkKillzone)

string killzoneText =
     not enableKillzoneArming ? "OFF" :
     killzoneArmed ? (inLondonKillzone and inNewYorkKillzone ? "ARMED LON/NY" : inLondonKillzone ? "ARMED LONDON" : "ARMED NY") :
     "IDLE"

color killzoneColor =
     killzoneArmed ? bullishColor : neutralColor

string currentSessionText =
     inAsianSession and inLondonSession and inNewYorkSession ? "ALL" :
     inLondonSession and inNewYorkSession ? "LON/NY" :
     inAsianSession and inLondonSession ? "ASIA/LON" :
     inAsianSession and inNewYorkSession ? "ASIA/NY" :
     inAsianSession ? "ASIAN" :
     inLondonSession ? "LONDON" :
     inNewYorkSession ? "NEW YORK" :
     "OFF"

color currentSessionColor =
     currentSessionText == "OFF" ? neutralColor :
     str.contains(currentSessionText, "LON") or currentSessionText == "LONDON" ? londonSessionColor :
     str.contains(currentSessionText, "NY") or currentSessionText == "NEW YORK" ? newYorkSessionColor :
     asianSessionColor

var array<box> sessionBoxHistory = array.new_box()

var bool asianWasActive = false
var float asianHigh = na
var float asianLow = na
var int asianStartBar = na
var box asianBox = na
var float asianFinalHigh = na
var float asianFinalLow = na
var bool asianHighBroken = true
var bool asianLowBroken = true
var line asianHighLine = na
var line asianLowLine = na

var bool londonWasActive = false
var float londonHigh = na
var float londonLow = na
var int londonStartBar = na
var box londonBox = na
var float londonFinalHigh = na
var float londonFinalLow = na
var bool londonHighBroken = true
var bool londonLowBroken = true
var line londonHighLine = na
var line londonLowLine = na

var bool newYorkWasActive = false
var float newYorkHigh = na
var float newYorkLow = na
var int newYorkStartBar = na
var box newYorkBox = na
var float newYorkFinalHigh = na
var float newYorkFinalLow = na
var bool newYorkHighBroken = true
var bool newYorkLowBroken = true
var line newYorkHighLine = na
var line newYorkLowLine = na

var string lastSessionEvent = "—"

bool asianCompleteEvent      = false
bool londonCompleteEvent     = false
bool newYorkCompleteEvent    = false
bool asianHighBreakEvent     = false
bool asianLowBreakEvent      = false
bool londonHighBreakEvent    = false
bool londonLowBreakEvent     = false
bool newYorkHighBreakEvent   = false
bool newYorkLowBreakEvent    = false

//------------------------------------------------------------
// ASIAN SESSION
//------------------------------------------------------------

bool asianStarted = inAsianSession and not asianWasActive
bool asianEnded   = not inAsianSession and asianWasActive

if asianStarted
    asianHigh := high
    asianLow := low
    asianStartBar := bar_index

    if showSessions
        asianBox := box.new(
             bar_index,
             high,
             bar_index,
             low,
             xloc = xloc.bar_index,
             border_color = color.new(asianSessionColor, 40),
             border_width = 1,
             bgcolor = color.new(asianSessionColor, 90),
             extend = extend.none
        )
        array.push(sessionBoxHistory, asianBox)
        while array.size(sessionBoxHistory) > maxSessionBoxes
            box oldSessionBox = array.get(sessionBoxHistory, 0)
            if not na(oldSessionBox)
                box.delete(oldSessionBox)
            array.remove(sessionBoxHistory, 0)

if inAsianSession and barstate.isconfirmed and not na(asianHigh)
    asianHigh := math.max(asianHigh, high)
    asianLow := math.min(asianLow, low)

    if showSessions and not na(asianBox)
        box.set_right(asianBox, bar_index)
        box.set_top(asianBox, asianHigh)
        box.set_bottom(asianBox, asianLow)

if asianEnded
    asianFinalHigh := asianHigh
    asianFinalLow := asianLow
    asianHighBroken := false
    asianLowBroken := false
    lastSessionEvent := "Asian Complete"
    asianCompleteEvent := true

    if showSessions and not na(asianBox)
        box.set_right(asianBox, bar_index - 1)

    if showSessionLevels and not na(asianFinalHigh) and not na(asianFinalLow)
        if not na(asianHighLine)
            line.delete(asianHighLine)
        if not na(asianLowLine)
            line.delete(asianLowLine)

        asianHighLine := line.new(
             asianStartBar,
             asianFinalHigh,
             bar_index,
             asianFinalHigh,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dashed,
             color = color.new(asianSessionColor, 35),
             width = 1
        )

        asianLowLine := line.new(
             asianStartBar,
             asianFinalLow,
             bar_index,
             asianFinalLow,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dashed,
             color = color.new(asianSessionColor, 35),
             width = 1
        )

asianWasActive := inAsianSession

if barstate.isconfirmed and not na(asianFinalHigh) and not na(asianFinalLow)
    if not asianHighBroken and close > asianFinalHigh
        asianHighBroken := true
        asianHighBreakEvent := true
        lastSessionEvent := "Asian High Break"

    if not asianLowBroken and close < asianFinalLow
        asianLowBroken := true
        asianLowBreakEvent := true
        lastSessionEvent := "Asian Low Break"

//------------------------------------------------------------
// LONDON SESSION
//------------------------------------------------------------

bool londonStarted = inLondonSession and not londonWasActive
bool londonEnded   = not inLondonSession and londonWasActive

if londonStarted
    londonHigh := high
    londonLow := low
    londonStartBar := bar_index

    if showSessions
        londonBox := box.new(
             bar_index,
             high,
             bar_index,
             low,
             xloc = xloc.bar_index,
             border_color = color.new(londonSessionColor, 40),
             border_width = 1,
             bgcolor = color.new(londonSessionColor, 90),
             extend = extend.none
        )
        array.push(sessionBoxHistory, londonBox)
        while array.size(sessionBoxHistory) > maxSessionBoxes
            box oldSessionBox = array.get(sessionBoxHistory, 0)
            if not na(oldSessionBox)
                box.delete(oldSessionBox)
            array.remove(sessionBoxHistory, 0)

if inLondonSession and barstate.isconfirmed and not na(londonHigh)
    londonHigh := math.max(londonHigh, high)
    londonLow := math.min(londonLow, low)

    if showSessions and not na(londonBox)
        box.set_right(londonBox, bar_index)
        box.set_top(londonBox, londonHigh)
        box.set_bottom(londonBox, londonLow)

if londonEnded
    londonFinalHigh := londonHigh
    londonFinalLow := londonLow
    londonHighBroken := false
    londonLowBroken := false
    lastSessionEvent := "London Complete"
    londonCompleteEvent := true

    if showSessions and not na(londonBox)
        box.set_right(londonBox, bar_index - 1)

    if showSessionLevels and not na(londonFinalHigh) and not na(londonFinalLow)
        if not na(londonHighLine)
            line.delete(londonHighLine)
        if not na(londonLowLine)
            line.delete(londonLowLine)

        londonHighLine := line.new(
             londonStartBar,
             londonFinalHigh,
             bar_index,
             londonFinalHigh,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dashed,
             color = color.new(londonSessionColor, 35),
             width = 1
        )

        londonLowLine := line.new(
             londonStartBar,
             londonFinalLow,
             bar_index,
             londonFinalLow,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dashed,
             color = color.new(londonSessionColor, 35),
             width = 1
        )

londonWasActive := inLondonSession

if barstate.isconfirmed and not na(londonFinalHigh) and not na(londonFinalLow)
    if not londonHighBroken and close > londonFinalHigh
        londonHighBroken := true
        londonHighBreakEvent := true
        lastSessionEvent := "London High Break"

    if not londonLowBroken and close < londonFinalLow
        londonLowBroken := true
        londonLowBreakEvent := true
        lastSessionEvent := "London Low Break"

//------------------------------------------------------------
// NEW YORK SESSION
//------------------------------------------------------------

bool newYorkStarted = inNewYorkSession and not newYorkWasActive
bool newYorkEnded   = not inNewYorkSession and newYorkWasActive

if newYorkStarted
    newYorkHigh := high
    newYorkLow := low
    newYorkStartBar := bar_index

    if showSessions
        newYorkBox := box.new(
             bar_index,
             high,
             bar_index,
             low,
             xloc = xloc.bar_index,
             border_color = color.new(newYorkSessionColor, 40),
             border_width = 1,
             bgcolor = color.new(newYorkSessionColor, 90),
             extend = extend.none
        )
        array.push(sessionBoxHistory, newYorkBox)
        while array.size(sessionBoxHistory) > maxSessionBoxes
            box oldSessionBox = array.get(sessionBoxHistory, 0)
            if not na(oldSessionBox)
                box.delete(oldSessionBox)
            array.remove(sessionBoxHistory, 0)

if inNewYorkSession and barstate.isconfirmed and not na(newYorkHigh)
    newYorkHigh := math.max(newYorkHigh, high)
    newYorkLow := math.min(newYorkLow, low)

    if showSessions and not na(newYorkBox)
        box.set_right(newYorkBox, bar_index)
        box.set_top(newYorkBox, newYorkHigh)
        box.set_bottom(newYorkBox, newYorkLow)

if newYorkEnded
    newYorkFinalHigh := newYorkHigh
    newYorkFinalLow := newYorkLow
    newYorkHighBroken := false
    newYorkLowBroken := false
    lastSessionEvent := "NY Complete"
    newYorkCompleteEvent := true

    if showSessions and not na(newYorkBox)
        box.set_right(newYorkBox, bar_index - 1)

    if showSessionLevels and not na(newYorkFinalHigh) and not na(newYorkFinalLow)
        if not na(newYorkHighLine)
            line.delete(newYorkHighLine)
        if not na(newYorkLowLine)
            line.delete(newYorkLowLine)

        newYorkHighLine := line.new(
             newYorkStartBar,
             newYorkFinalHigh,
             bar_index,
             newYorkFinalHigh,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dashed,
             color = color.new(newYorkSessionColor, 35),
             width = 1
        )

        newYorkLowLine := line.new(
             newYorkStartBar,
             newYorkFinalLow,
             bar_index,
             newYorkFinalLow,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dashed,
             color = color.new(newYorkSessionColor, 35),
             width = 1
        )

newYorkWasActive := inNewYorkSession

if barstate.isconfirmed and not na(newYorkFinalHigh) and not na(newYorkFinalLow)
    if not newYorkHighBroken and close > newYorkFinalHigh
        newYorkHighBroken := true
        newYorkHighBreakEvent := true
        lastSessionEvent := "NY High Break"

    if not newYorkLowBroken and close < newYorkFinalLow
        newYorkLowBroken := true
        newYorkLowBreakEvent := true
        lastSessionEvent := "NY Low Break"


//====================================================================
// MULTI-TIMEFRAME ENGINE
//====================================================================
//
// Confirmed HTF trend uses the same EMA stack rules as the chart
// timeframe, evaluated on the higher timeframe.
//
// Non-repainting policy:
// - lookahead_off
// - series offset [1] so only the last completed HTF bar is used
//
// Alignment:
// - Trend Align: chart trendState matches HTF trend
// - Structure Align: structuralDirection matches HTF trend
//====================================================================

// Returns 1 / 0 / -1 using the shared EMA trend rules.
calcTrendState() =>
    float calcEmaFast = ta.ema(close, fastEmaLength)
    float calcEmaMedium = ta.ema(close, mediumEmaLength)
    float calcEmaSlow = ta.ema(close, slowEmaLength)

    bool calcEmaBullish =
         calcEmaFast > calcEmaMedium and
         calcEmaMedium > calcEmaSlow

    bool calcEmaBearish =
         calcEmaFast < calcEmaMedium and
         calcEmaMedium < calcEmaSlow

    bool calcPriceBullish =
         not usePriceFilter or
         close > calcEmaSlow

    bool calcPriceBearish =
         not usePriceFilter or
         close < calcEmaSlow

    bool calcBullishTrend =
         calcEmaBullish and
         calcPriceBullish

    bool calcBearishTrend =
         calcEmaBearish and
         calcPriceBearish

    calcBullishTrend ? 1 : calcBearishTrend ? -1 : 0

// Always request for series consistency; gate usage with enableMtf.
int htfTrendStateRaw = request.security(
     syminfo.tickerid,
     mtfTimeframe,
     calcTrendState()[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

int htfTrendState = enableMtf ? htfTrendStateRaw : 0

string htfTrendText =
     not enableMtf ? "OFF" :
     htfTrendState == 1 ? "BULLISH" :
     htfTrendState == -1 ? "BEARISH" :
     "NEUTRAL"

color htfTrendColor =
     not enableMtf ? neutralColor :
     htfTrendState == 1 ? bullishColor :
     htfTrendState == -1 ? bearishColor :
     neutralColor

bool mtfTrendBullishAligned =
     enableMtf and
     trendState == 1 and
     htfTrendState == 1

bool mtfTrendBearishAligned =
     enableMtf and
     trendState == -1 and
     htfTrendState == -1

bool mtfTrendConflict =
     enableMtf and
     trendState != 0 and
     htfTrendState != 0 and
     trendState != htfTrendState

bool mtfStructureBullishAligned =
     enableMtf and
     structuralDirection == 1 and
     htfTrendState == 1

bool mtfStructureBearishAligned =
     enableMtf and
     structuralDirection == -1 and
     htfTrendState == -1

string mtfAlignText =
     not enableMtf ? "OFF" :
     mtfTrendBullishAligned ? "BULL ALIGN" :
     mtfTrendBearishAligned ? "BEAR ALIGN" :
     mtfTrendConflict ? "CONFLICT" :
     mtfStructureBullishAligned ? "STRUCT BULL" :
     mtfStructureBearishAligned ? "STRUCT BEAR" :
     "MIXED"

color mtfAlignColor =
     mtfTrendBullishAligned ? bullishColor :
     mtfTrendBearishAligned ? bearishColor :
     mtfTrendConflict ? bearishColor :
     neutralColor

bool mtfBullishAlignEvent = false
bool mtfBearishAlignEvent = false
bool mtfConflictEvent = false

var int previousMtfAlignState = 0
// 1 = bull align, -1 = bear align, 2 = conflict, 0 = other

int currentMtfAlignState =
     mtfTrendBullishAligned ? 1 :
     mtfTrendBearishAligned ? -1 :
     mtfTrendConflict ? 2 :
     0

if enableMtf and currentMtfAlignState != previousMtfAlignState
    if currentMtfAlignState == 1
        mtfBullishAlignEvent := true
    else if currentMtfAlignState == -1
        mtfBearishAlignEvent := true
    else if currentMtfAlignState == 2
        mtfConflictEvent := true

previousMtfAlignState := currentMtfAlignState


//====================================================================
// CORE BIAS ENGINE
//====================================================================
//
// Chart bias remains Phase 1 scoring for stability.
// Confidence Engine below aggregates broader confluence.
//====================================================================

int bullishPoints = 0
int bearishPoints = 0

if bullishTrend
    bullishPoints += 2

if bearishTrend
    bearishPoints += 2

if bullishStructure
    bullishPoints += 2

if bearishStructure
    bearishPoints += 2

if close > emaFast
    bullishPoints += 1

if close < emaFast
    bearishPoints += 1


//====================================================================
// MARKET BIAS
//====================================================================

string marketBias =
     bullishPoints > bearishPoints ? "BUY BIAS" :
     bearishPoints > bullishPoints ? "SELL BIAS" :
     "NEUTRAL"

color marketBiasColor =
     bullishPoints > bearishPoints ? bullishColor :
     bearishPoints > bullishPoints ? bearishColor :
     neutralColor


//====================================================================
// ALIGNMENT SCORE
//====================================================================
//
// NOT a trade probability.
//
// This measures how strongly our current Phase 1 conditions agree.
//====================================================================

int maximumPoints = 5

int dominantPoints =
     math.max(
         bullishPoints,
         bearishPoints
     )

float alignmentScore =
     maximumPoints > 0
         ? dominantPoints / maximumPoints * 100.0
         : 0.0


//====================================================================
// PREMIUM / DISCOUNT ENGINE
//====================================================================
//
// Uses the active confirmed swing range:
// - Equilibrium = midpoint
// - Premium = above equilibrium band
// - Discount = below equilibrium band
//
// Non-repainting: swing extremes are confirmed pivots only.
//====================================================================

var line equilibriumLine = na

bool pdRangeReady =
     not na(activeSwingHigh) and
     not na(activeSwingLow) and
     activeSwingHigh > activeSwingLow

float equilibriumLevel =
     pdRangeReady ? (activeSwingHigh + activeSwingLow) * 0.5 : na

float pdRangeSize =
     pdRangeReady ? activeSwingHigh - activeSwingLow : na

float equilibriumBand =
     pdRangeReady ? pdRangeSize * (equilibriumBandPct / 100.0) : na

bool inEquilibrium =
     pdRangeReady and
     math.abs(close - equilibriumLevel) <= equilibriumBand

bool inPremium =
     pdRangeReady and
     not inEquilibrium and
     close > equilibriumLevel

bool inDiscount =
     pdRangeReady and
     not inEquilibrium and
     close < equilibriumLevel

string pdZoneText =
     not pdRangeReady ? "—" :
     inEquilibrium ? "EQUILIBRIUM" :
     inPremium ? "PREMIUM" :
     inDiscount ? "DISCOUNT" :
     "—"

color pdZoneColor =
     inPremium ? bearishColor :
     inDiscount ? bullishColor :
     neutralColor

if showPremiumDiscount and pdRangeReady
    if na(equilibriumLine)
        equilibriumLine := line.new(
             bar_index,
             equilibriumLevel,
             bar_index + 1,
             equilibriumLevel,
             xloc = xloc.bar_index,
             extend = extend.right,
             style = line.style_dotted,
             color = color.new(neutralColor, 20),
             width = 1
        )
    else
        line.set_y1(equilibriumLine, equilibriumLevel)
        line.set_y2(equilibriumLine, equilibriumLevel)
        line.set_x2(equilibriumLine, bar_index)
else
    if not na(equilibriumLine)
        line.delete(equilibriumLine)
        equilibriumLine := na

bgcolor(
     showPremiumDiscountBg and inPremium ? color.new(bearishColor, 94) :
     showPremiumDiscountBg and inDiscount ? color.new(bullishColor, 94) :
     na,
     title = "Premium / Discount Shade"
)


//====================================================================
// CONFIDENCE ENGINE
//====================================================================
//
// Confluence score across confirmed engines.
//
// Base weights plus quality bonuses (PD, breaker, killzone arming).
// Final raw score is clamped to 100 before MTF conflict penalty.
//
// NOT a win probability. It only measures agreement quality.
// Uses already-confirmed engine state only.
//====================================================================

bool hasActiveBullishOb = false
bool hasActiveBearishOb = false

if array.size(obDirections) > 0
    for i = 0 to array.size(obDirections) - 1
        int obDir = array.get(obDirections, i)
        if obDir == 1
            hasActiveBullishOb := true
        if obDir == -1
            hasActiveBearishOb := true

bool hasActiveBullishBreaker = false
bool hasActiveBearishBreaker = false

if array.size(breakerDirections) > 0
    for i = 0 to array.size(breakerDirections) - 1
        int brDir = array.get(breakerDirections, i)
        if brDir == 1
            hasActiveBullishBreaker := true
        if brDir == -1
            hasActiveBearishBreaker := true

bool hasActiveBullishFvg = false
bool hasActiveBearishFvg = false

if array.size(fvgDirections) > 0
    for i = 0 to array.size(fvgDirections) - 1
        int fvgDir = array.get(fvgDirections, i)
        if fvgDir == 1
            hasActiveBullishFvg := true
        if fvgDir == -1
            hasActiveBearishFvg := true

bool bullishStructureEvent =
     lastEvent == "Bullish BOS" or
     lastEvent == "Bullish CHoCH"

bool bearishStructureEvent =
     lastEvent == "Bearish BOS" or
     lastEvent == "Bearish CHoCH"

bool bullishLiquiditySweep = lastLiquidityEvent == "EQL Sweep"
bool bearishLiquiditySweep = lastLiquidityEvent == "EQH Sweep"

int bullishConfidencePoints = 0
int bearishConfidencePoints = 0

if enableConfidence
    if trendState == 1
        bullishConfidencePoints += 18
    if trendState == -1
        bearishConfidencePoints += 18

    if structuralDirection == 1
        bullishConfidencePoints += 14
    if structuralDirection == -1
        bearishConfidencePoints += 14

    if bullishStructure
        bullishConfidencePoints += 10
    if bearishStructure
        bearishConfidencePoints += 10

    if mtfTrendBullishAligned
        bullishConfidencePoints += 18
    if mtfTrendBearishAligned
        bearishConfidencePoints += 18

    if bullishStructureEvent
        bullishConfidencePoints += 10
    if bearishStructureEvent
        bearishConfidencePoints += 10

    if hasActiveBullishOb
        bullishConfidencePoints += 10
    if hasActiveBearishOb
        bearishConfidencePoints += 10

    if hasActiveBullishBreaker
        bullishConfidencePoints += 6
    if hasActiveBearishBreaker
        bearishConfidencePoints += 6

    if hasActiveBullishFvg
        bullishConfidencePoints += 8
    if hasActiveBearishFvg
        bearishConfidencePoints += 8

    if bullishLiquiditySweep
        bullishConfidencePoints += 7
    if bearishLiquiditySweep
        bearishConfidencePoints += 7

    // Premium / Discount alignment quality bonus.
    if inDiscount
        bullishConfidencePoints += 6
    if inPremium
        bearishConfidencePoints += 6

    // Killzone arming replaces broad session bonus.
    if killzoneArmed
        if trendState == 1
            bullishConfidencePoints += 8
        else if trendState == -1
            bearishConfidencePoints += 8
        else if structuralDirection == 1
            bullishConfidencePoints += 8
        else if structuralDirection == -1
            bearishConfidencePoints += 8

int confidenceDirection =
     not enableConfidence ? 0 :
     bullishConfidencePoints > bearishConfidencePoints ? 1 :
     bearishConfidencePoints > bullishConfidencePoints ? -1 :
     0

float confidenceScoreRaw =
     not enableConfidence ? 0.0 :
     math.min(
         100.0,
         confidenceDirection == 1 ? bullishConfidencePoints :
         confidenceDirection == -1 ? bearishConfidencePoints :
         math.max(bullishConfidencePoints, bearishConfidencePoints)
     )

float confidenceScore =
     mtfTrendConflict
         ? math.max(0.0, confidenceScoreRaw - mtfConflictPenalty)
         : confidenceScoreRaw

string confidenceGrade =
     not enableConfidence ? "OFF" :
     confidenceScore >= 80 ? "VERY HIGH" :
     confidenceScore >= 60 ? "HIGH" :
     confidenceScore >= 40 ? "MEDIUM" :
     "LOW"

string confidenceDirectionText =
     not enableConfidence ? "OFF" :
     confidenceDirection == 1 ? "BULLISH" :
     confidenceDirection == -1 ? "BEARISH" :
     "NEUTRAL"

string confidenceText =
     not enableConfidence
         ? "OFF"
         : str.tostring(confidenceScore, "#") + "% " + confidenceGrade

color confidenceColor =
     not enableConfidence ? neutralColor :
     confidenceDirection == 1 ? bullishColor :
     confidenceDirection == -1 ? bearishColor :
     neutralColor

bool highConfidenceBullishEvent = false
bool highConfidenceBearishEvent = false

var float previousConfidenceScore = 0.0
var int previousConfidenceDirection = 0

bool crossedHighConfidence =
     enableConfidence and
     confidenceScore >= confidenceAlertThreshold and
     (
         previousConfidenceScore < confidenceAlertThreshold or
         previousConfidenceDirection != confidenceDirection
     )

if crossedHighConfidence and confidenceDirection == 1
    highConfidenceBullishEvent := true

if crossedHighConfidence and confidenceDirection == -1
    highConfidenceBearishEvent := true

previousConfidenceScore := confidenceScore
previousConfidenceDirection := confidenceDirection


//====================================================================
// RISK ENGINE
//====================================================================
//
// Builds an educational risk model from confirmed structure:
// - Direction from Confidence Engine (clear bullish / bearish only)
// - Entry reference = confirmed close
// - Stop beyond active confirmed swing +/- ATR buffer
// - TP1 / TP2 from configured reward:risk multiples
//
// Non-repainting:
// - Requires barstate.isconfirmed for model updates
// - Uses confirmed swing levels only
// - No future-looking projections beyond fixed R multiples
//====================================================================

float riskAtr = ta.atr(14)

var float riskEntry = na
var float riskStop = na
var float riskTp1 = na
var float riskTp2 = na
var float riskDistance = na
var float riskSuggestedQty = na
var int riskDirection = 0
var bool riskModelValid = false

var line riskStopLine = na
var line riskTp1Line = na
var line riskTp2Line = na

bool riskModelReadyBullishEvent = false
bool riskModelReadyBearishEvent = false
bool riskModelInvalidEvent = false

var bool previousRiskModelValid = false
var int previousRiskDirection = 0

if enableRisk and barstate.isconfirmed
    bool confidenceAllowsRisk =
         confidenceDirection != 0 and
         confidenceScore >= minConfidenceForRisk

    bool killzoneAllowsRisk =
         not requireKillzoneForRisk or
         not enableKillzoneArming or
         killzoneArmed

    bool pdAllowsRisk =
         not requirePdAlignForRisk or
         (
             confidenceDirection == 1 and inDiscount
         ) or
         (
             confidenceDirection == -1 and inPremium
         )

    bool swingsReady =
         not na(activeSwingHigh) and
         not na(activeSwingLow)

    if confidenceAllowsRisk and killzoneAllowsRisk and pdAllowsRisk and swingsReady
        int modelDirection = confidenceDirection
        float modelEntry = close
        float atrBuffer = riskAtr * riskAtrBuffer

        float modelStop =
             modelDirection == 1
                 ? activeSwingLow - atrBuffer
                 : activeSwingHigh + atrBuffer

        float modelRiskDistance =
             modelDirection == 1
                 ? modelEntry - modelStop
                 : modelStop - modelEntry

        bool modelValid = modelRiskDistance > 0

        if modelValid
            float modelTp1 =
                 modelDirection == 1
                     ? modelEntry + modelRiskDistance * rewardRiskTp1
                     : modelEntry - modelRiskDistance * rewardRiskTp1

            float modelTp2 =
                 modelDirection == 1
                     ? modelEntry + modelRiskDistance * rewardRiskTp2
                     : modelEntry - modelRiskDistance * rewardRiskTp2

            float riskAmount = accountEquity * (riskPercent / 100.0)
            float pointValue = syminfo.pointvalue
            float modelQty =
                 pointValue > 0
                     ? riskAmount / (modelRiskDistance * pointValue)
                     : na

            bool becameReady =
                 not previousRiskModelValid or
                 previousRiskDirection != modelDirection

            riskEntry := modelEntry
            riskStop := modelStop
            riskTp1 := modelTp1
            riskTp2 := modelTp2
            riskDistance := modelRiskDistance
            riskSuggestedQty := modelQty
            riskDirection := modelDirection
            riskModelValid := true

            if becameReady and modelDirection == 1
                riskModelReadyBullishEvent := true
            if becameReady and modelDirection == -1
                riskModelReadyBearishEvent := true

            if showRiskLevels
                if not na(riskStopLine)
                    line.delete(riskStopLine)
                if not na(riskTp1Line)
                    line.delete(riskTp1Line)
                if not na(riskTp2Line)
                    line.delete(riskTp2Line)

                color stopColor = color.new(bearishColor, 10)
                color tpColor = color.new(bullishColor, 10)

                riskStopLine := line.new(
                     bar_index,
                     modelStop,
                     bar_index + 1,
                     modelStop,
                     xloc = xloc.bar_index,
                     extend = extend.right,
                     style = line.style_solid,
                     color = stopColor,
                     width = 2
                )

                riskTp1Line := line.new(
                     bar_index,
                     modelTp1,
                     bar_index + 1,
                     modelTp1,
                     xloc = xloc.bar_index,
                     extend = extend.right,
                     style = line.style_dashed,
                     color = tpColor,
                     width = 1
                )

                riskTp2Line := line.new(
                     bar_index,
                     modelTp2,
                     bar_index + 1,
                     modelTp2,
                     xloc = xloc.bar_index,
                     extend = extend.right,
                     style = line.style_dotted,
                     color = tpColor,
                     width = 1
                )
        else
            if previousRiskModelValid
                riskModelInvalidEvent := true

            riskModelValid := false
            riskDirection := 0
            riskEntry := na
            riskStop := na
            riskTp1 := na
            riskTp2 := na
            riskDistance := na
            riskSuggestedQty := na

            if not na(riskStopLine)
                line.delete(riskStopLine)
            if not na(riskTp1Line)
                line.delete(riskTp1Line)
            if not na(riskTp2Line)
                line.delete(riskTp2Line)

            riskStopLine := na
            riskTp1Line := na
            riskTp2Line := na
    else
        if previousRiskModelValid
            riskModelInvalidEvent := true

        riskModelValid := false
        riskDirection := 0
        riskEntry := na
        riskStop := na
        riskTp1 := na
        riskTp2 := na
        riskDistance := na
        riskSuggestedQty := na

        if not na(riskStopLine)
            line.delete(riskStopLine)
        if not na(riskTp1Line)
            line.delete(riskTp1Line)
        if not na(riskTp2Line)
            line.delete(riskTp2Line)

        riskStopLine := na
        riskTp1Line := na
        riskTp2Line := na

    previousRiskModelValid := riskModelValid
    previousRiskDirection := riskDirection
else if not enableRisk
    riskModelValid := false
    riskDirection := 0
    if not na(riskStopLine)
        line.delete(riskStopLine)
    if not na(riskTp1Line)
        line.delete(riskTp1Line)
    if not na(riskTp2Line)
        line.delete(riskTp2Line)
    riskStopLine := na
    riskTp1Line := na
    riskTp2Line := na

string riskDirectionText =
     not enableRisk ? "OFF" :
     not riskModelValid ? "WAIT" :
     riskDirection == 1 ? "LONG" :
     riskDirection == -1 ? "SHORT" :
     "WAIT"

string riskRrText =
     not enableRisk ? "OFF" :
     not riskModelValid ? "—" :
     "1:" + str.tostring(rewardRiskTp2, "#.#")

string riskText =
     not enableRisk ? "OFF" :
     not riskModelValid ? "WAIT" :
     riskDirectionText + " " + riskRrText

color riskColor =
     not enableRisk or not riskModelValid ? neutralColor :
     riskDirection == 1 ? bullishColor :
     riskDirection == -1 ? bearishColor :
     neutralColor

string riskQtyText =
     not enableRisk or not riskModelValid or na(riskSuggestedQty)
         ? "—"
         : str.tostring(riskSuggestedQty, "#.###")


//====================================================================
// LAST EVENT / OB / FVG / LIQUIDITY / SESSION COLORS
//====================================================================

color lastEventColor =
     str.contains(lastEvent, "Bullish") ? bullishColor :
     str.contains(lastEvent, "Bearish") ? bearishColor :
     neutralColor

color lastObColor =
     str.contains(lastObEvent, "Bullish") ? bullishColor :
     str.contains(lastObEvent, "Bearish") ? bearishColor :
     neutralColor

color lastFvgColor =
     str.contains(lastFvgEvent, "Bullish") ? bullishColor :
     str.contains(lastFvgEvent, "Bearish") ? bearishColor :
     neutralColor

color lastLiquidityColor =
     str.contains(lastLiquidityEvent, "EQL") ? bullishColor :
     str.contains(lastLiquidityEvent, "EQH") ? bearishColor :
     neutralColor

color lastSessionEventColor =
     str.contains(lastSessionEvent, "High Break") ? bullishColor :
     str.contains(lastSessionEvent, "Low Break") ? bearishColor :
     str.contains(lastSessionEvent, "Asian") ? asianSessionColor :
     str.contains(lastSessionEvent, "London") ? londonSessionColor :
     str.contains(lastSessionEvent, "NY") ? newYorkSessionColor :
     neutralColor


//====================================================================
// DASHBOARD
//====================================================================

var table dashboard = table.new(
     position.top_right,
     2,
     22,
     bgcolor = color.new(color.black, 15),
     frame_color = color.new(color.white, 70),
     frame_width = 1,
     border_color = color.new(color.white, 90),
     border_width = 1
)

if barstate.islast

    if showDashboard

        //------------------------------------------------------------
        // HEADER
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             0,
             "ALPHAFX AI",
             text_color = color.white,
             bgcolor = color.new(color.black, 0),
             text_size = size.small
        )

        table.cell(
             dashboard,
             1,
             0,
             "v1.2",
             text_color = color.silver,
             bgcolor = color.new(color.black, 0),
             text_size = size.small
        )

        //------------------------------------------------------------
        // PROFILE
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             1,
             "Profile",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             1,
             profilePreset,
             text_color = color.white
        )

        //------------------------------------------------------------
        // TREND
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             2,
             "Trend",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             2,
             trendText,
             text_color = trendColor
        )

        //------------------------------------------------------------
        // HTF TREND
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             3,
             "HTF Trend",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             3,
             htfTrendText,
             text_color = htfTrendColor
        )

        //------------------------------------------------------------
        // MTF ALIGN
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             4,
             "MTF Align",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             4,
             mtfAlignText,
             text_color = mtfAlignColor
        )

        //------------------------------------------------------------
        // STRUCTURE
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             5,
             "Structure",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             5,
             structureText,
             text_color = structureColor
        )

        //------------------------------------------------------------
        // ZONE (PREMIUM / DISCOUNT)
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             6,
             "Zone",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             6,
             pdZoneText,
             text_color = pdZoneColor
        )

        //------------------------------------------------------------
        // SESSION
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             7,
             "Session",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             7,
             currentSessionText,
             text_color = currentSessionColor
        )

        //------------------------------------------------------------
        // KILLZONE
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             8,
             "Killzone",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             8,
             killzoneText,
             text_color = killzoneColor
        )

        //------------------------------------------------------------
        // LAST EVENT
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             9,
             "Last Event",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             9,
             lastEvent,
             text_color = lastEventColor
        )

        //------------------------------------------------------------
        // LAST OB
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             10,
             "Last OB",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             10,
             lastObEvent,
             text_color = lastObColor
        )

        //------------------------------------------------------------
        // LAST BREAKER
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             11,
             "Last BR",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             11,
             lastBreakerEvent,
             text_color =
                 str.contains(lastBreakerEvent, "Bullish") ? bullishColor :
                 str.contains(lastBreakerEvent, "Bearish") ? bearishColor :
                 neutralColor
        )

        //------------------------------------------------------------
        // LAST FVG
        //------------------------------------------------------------

        table.cell(
             dashboard,
             0,
             12,
             "Last FVG",
             text_color = color.silver
        )

        table.cell(
             dashboard,
             1,
             12,
             lastFvgEvent,
             text_color = lastFvgColor
        )

        //------------------------------------------------------------
